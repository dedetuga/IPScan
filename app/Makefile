# Used only by the official Axis SDK build path (Dockerfile, `acap-build`).
# The Go binary is produced by the Go build stage and copied in already named
# `ipscan` (== manifest appName), so acap-build just needs to package it.
PROG = ipscan

all:
	@echo "ipscan binary is prebuilt by the Go stage; nothing to compile here."

clean:
	@true
